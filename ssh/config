# Git uses SSH for operations such as clone, pull, and push.
# For a remote like:
#   git@github.com:user/repository.git
# Git connects to github.com through SSH.
# Therefore, this configuration uses `Host github.com`
# to match the hostname used by the Git remote.

Host github.com
    HostName github.com
    User git
    Port 22
    RequestTTY no
    IdentityFile ~/.ssh/id_ed25519_github
