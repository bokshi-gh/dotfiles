# =========================================================================
# Git internally uses SSH to connect to github.com for operations like 
# clone, pull, and push. 
#
# Because of this, it automatically invokes `ssh git@github.com` under 
# the hood whenever you run a Git command.
#
# Therefore, the host alias in this config must be exactly github.com. 
# If you name it anything else, SSH will not match it and this block 
# won't be used.
# =========================================================================
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
