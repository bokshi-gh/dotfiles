# GIT ALIASES START
alias gi='git init'
alias gcl='git clone'

alias ga='git add'
alias gc='git commit -m'
alias gca='git commit -m --amend'
alias gl='git log'
alias gs='git status'

alias gb='git branch'
alias gco='git checkout'

alias gr='git remote'
alias gra='git remote add'

alias gpl='git pull'
alias gps='git push'
# GIT ALIASES END

# BASH COMMAND ALIASES START
alias cleandir='rm -rf ./* ./.??*'
# BASH COMMAND ALIASES END
