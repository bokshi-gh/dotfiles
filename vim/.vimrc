" Enable line numbers
set number

" Enable syntax highlighting
syntax on

let mapleader = " "

" Open terminal (Vim 8+)
nnoremap <leader>t :terminal<CR>

" Write (save file)
nnoremap <leader>w :w<CR>

" Quit
nnoremap <leader>q :q<CR>

" Quit without saving
nnoremap <leader>Q :q!<CR>

" Write and quit
nnoremap <leader>wq :wq<CR>
