" Core
" ====

syntax on
filetype plugin indent on

set autoindent
set smartindent


" Indentation
" ===========

set tabstop=4
set shiftwidth=4
set expandtab


" Display
" =======

set number
set relativenumber
set showmode
set ruler


" Search
" ======

set incsearch
set hlsearch


" Editing
" =======

set mouse=a
set clipboard=unnamedplus


" File Handling
" =============

set noswapfile
