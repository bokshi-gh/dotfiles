" Syntax and Filetype
" ===================

syntax on
filetype plugin indent on


" Indentation
" ===========

set autoindent
set tabstop=4
set shiftwidth=4
set expandtab


" Display
" =======

set number
set relativenumber
set showmode
set ruler


" Search
" ======

set incsearch
set hlsearch


" Editing
" =======

set mouse=a
set clipboard=unnamedplus


" File Handling
" =============

set noswapfile
